#!/bin/sh
# Backs up the database and the uploaded files. Usage: backup-now
set -eu
[ -f /etc/backup.env ] && . /etc/backup.env

stamp=$(date -u +%Y-%m-%d_%H%M%S)
cd /backups

pg_dump --format=custom --file=.db.partial
mv .db.partial "db_${stamp}.dump"

tar -czf .files.partial -C /files .
mv .files.partial "files_${stamp}.tar.gz"

# Remove backups older than BACKUP_KEEP_DAYS (default 14).
find /backups -maxdepth 1 \( -name 'db_*.dump' -o -name 'files_*.tar.gz' \) -mtime +"${BACKUP_KEEP_DAYS:-14}" -delete

echo "Backup ${stamp} done: $(du -h "db_${stamp}.dump" | cut -f1) database, $(du -h "files_${stamp}.tar.gz" | cut -f1) files."
